# Agent reasoning backend: openai (GPT-4.1) or granite (local model).
AGENT_BACKEND=openai

# Used when AGENT_BACKEND=openai. Only the text query and tool results are sent.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1

# Used when AGENT_BACKEND=granite. Point this at a local OpenAI-compatible server.
GRANITE_BASE_URL=http://127.0.0.1:11434/v1
GRANITE_MODEL=granite3.3
GRANITE_API_KEY=ollama

# Local speech settings
WHISPER_MODEL=tiny
WAKE_WORD=hey buddy
WAKE_WORD_CHUNK_DURATION=1.5
SPEECH_ENERGY_THRESHOLD=0.015
SPEECH_RECORD_DURATION=8
PIPER_MODEL_PATH=data/voices/en_US-lessac-medium.onnx

REDIS_URL=redis://localhost:6379
LOG_LEVEL=INFO
